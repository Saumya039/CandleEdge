# ---- Backend (names/placeholders only; never commit real values) ----
DATABASE_URL=sqlite:///./data/stratagy.db
# simulator (default, SIMULATED data) | kite (needs the credentials below)
PROVIDER=simulator
WATCHLIST=NIFTY,BANKNIFTY
SIM_SEED=7
SIM_SPEED=60
KITE_API_KEY=
KITE_ACCESS_TOKEN=
KITE_STREAM=true
# Live order placement is not implemented. This flag is asserted OFF by tests and does nothing if set.
LIVE_ORDERS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
